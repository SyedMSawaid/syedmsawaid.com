---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Podcasts">
  <h1 class="mb-8 text-2xl font-semibold tracking-tight text-slate-900">Podcasts</h1>
  <p class="-mt-4 mb-10 text-sm text-slate-500">Episodes worth coming back to.</p>
  <div class="flex flex-col">
    <div class="border-t border-slate-100 py-6">
      <a href="https://tim.blog/2016/10/27/david-heinemeier-hansson/" target="_blank" rel="noopener" class="text-base leading-relaxed text-slate-900 transition-colors duration-150 hover:text-slate-500">David "DHH" Heinemeier Hansson: The Power of Being Outspoken (#195)</a>
      <p class="mt-1 mb-0 text-xs text-slate-400">The Tim Ferriss Show &middot; 2016</p>
    </div>
  </div>
</BaseLayout>

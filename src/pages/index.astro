---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import sawaidImage from "@/assets/images/sawaid.jpg";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatPostDate, postRoute, projectRoute, publishedPosts } from "@/lib/content";

const posts = publishedPosts(await getCollection("posts"));
const projects = (await getCollection("projects")).sort((a, b) => b.data.launched - a.data.launched);
---

<BaseLayout>
  <div class="mb-14 flex flex-col items-center justify-between gap-6 sm:flex-row">
    <div>
      <h1 class="mb-3 text-xl font-semibold tracking-tight text-slate-900">Syed Muhammad Sawaid</h1>
      <p class="m-0 text-sm leading-relaxed text-slate-500">
        Software engineer and filmmaker based in Marburg, Germany. Doing a Masters in Data Science at Philipps University Marburg. I write about software, life in Germany, and whatever catches my attention.
      </p>
    </div>
    <Image src={sawaidImage} alt="Syed Muhammad Sawaid" width={128} height={128} class="order-first h-32 w-32 shrink-0 rounded-xl object-cover sm:order-last" />
  </div>

  <section class="mb-12">
    <h2 class="mb-5 text-xs font-medium tracking-widest text-slate-400 uppercase">Writing</h2>
    <div class="flex flex-col">
      {posts.slice(0, 5).map((post) => (
        <a href={postRoute(post).url} class="group flex items-baseline justify-between gap-6 border-b border-slate-100 py-2.5 last:border-0">
          <span class="truncate text-sm text-slate-800 transition-colors duration-150 group-hover:text-slate-500">{post.data.title}</span>
          <time class="shrink-0 text-xs text-slate-400">{formatPostDate(post, "month")}</time>
        </a>
      ))}
    </div>
    <a href="/posts" class="mt-4 inline-block text-xs text-slate-400 transition-colors duration-150 hover:text-slate-900">All writing &rarr;</a>
  </section>

  <section class="mb-12">
    <h2 class="mb-5 text-xs font-medium tracking-widest text-slate-400 uppercase">Projects</h2>
    <div class="flex flex-col">
      {projects.map((project) => (
        <a href={projectRoute(project)} class="group flex items-baseline justify-between gap-6 border-b border-slate-100 py-2.5 last:border-0">
          <span class="text-sm text-slate-800 transition-colors duration-150 group-hover:text-slate-500">{project.data.title}</span>
          <span class="shrink-0 text-xs text-slate-400">{project.data.type}</span>
        </a>
      ))}
    </div>
    <a href="/projects" class="mt-4 inline-block text-xs text-slate-400 transition-colors duration-150 hover:text-slate-900">All projects &rarr;</a>

    <div class="pt-10">
      <div class="pb-2">
        <h2 class="text-lg font-bold">Future ventures</h2>
        <p class="text-sm">Things that I want to teach myself in 2026</p>
      </div>
      <ul class="list-inside list-disc">
        <li>Machine Leaning and Data Science</li>
        <li>Security</li>
        <li>DevOps</li>
        <li>Embedded Systems</li>
        <li>Scalable Systems</li>
        <li>Electrical Engineering</li>
      </ul>
    </div>
  </section>

  <section>
    <h2 class="mb-5 text-xs font-medium tracking-widest text-slate-400 uppercase">Get in touch</h2>
    <div class="flex flex-col gap-1.5">
      <a href="mailto:hi@syedmsawaid.com" class="text-sm text-slate-700 transition-colors duration-150 hover:text-slate-400">hi@syedmsawaid.com</a>
      <a href="https://x.com/syedmsawaid" target="_blank" rel="noopener" class="text-sm text-slate-700 transition-colors duration-150 hover:text-slate-400">@syedmsawaid on X</a>
      <a href="https://instagram.com/syedmsawaid" target="_blank" rel="noopener" class="text-sm text-slate-700 transition-colors duration-150 hover:text-slate-400">@syedmsawaid on Instagram</a>
    </div>
  </section>
</BaseLayout>

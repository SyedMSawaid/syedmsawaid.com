---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import PostLayout from "../../../../layouts/PostLayout.astro";
import { postRoute, publishedPosts } from "../../../../lib/content";

export async function getStaticPaths() {
  const posts = publishedPosts(await getCollection("posts"));

  return posts.map((post) => {
    const { year, month, day, slug } = postRoute(post);
    const index = posts.findIndex((candidate) => candidate.id === post.id);

    return {
      params: { year, month, day, slug },
      props: {
        post,
        previous: posts[index - 1],
        next: posts[index + 1],
      },
    };
  });
}

interface Props {
  post: CollectionEntry<"posts">;
  previous?: CollectionEntry<"posts">;
  next?: CollectionEntry<"posts">;
}

const { post, previous, next } = Astro.props;
const { Content } = await render(post);
---

<PostLayout {post} {previous} {next}>
  <Content />
</PostLayout>

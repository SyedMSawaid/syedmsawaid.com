---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Quotes">
  <h1 class="mb-8 text-2xl font-semibold tracking-tight text-slate-900">Quotes</h1>
  <p class="-mt-4 mb-10 text-sm text-slate-500">Lines that stuck with me.</p>
  <div class="flex flex-col">
    <div class="border-t border-slate-100 py-6">
      <p class="mb-3 text-base leading-relaxed text-slate-900">The Catastrophe You Fear Will Happen has Already Happened.</p>
      <a href="https://www.theschooloflife.com/article/the-catastrophe-you-fear-will-happen-has-already-happened/" target="_blank" rel="noopener" class="text-xs tracking-widest text-slate-400 uppercase transition-colors duration-150 hover:text-slate-900">The School of Life</a>
    </div>
  </div>
</BaseLayout>

---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatIssueDate, sortedIssues } from "@/lib/content";

const issues = sortedIssues(await getCollection("newsletter"));
---

<BaseLayout title="Newsletter">
  <h1 class="mb-8 text-2xl font-semibold tracking-tight text-slate-900">Newsletter</h1>
  <p class="-mt-4 mb-8 text-sm text-slate-500">
    Past issues, also published on
    <a href="https://syedmsawaid.substack.com" class="underline decoration-slate-300 underline-offset-2 transition-colors hover:decoration-slate-900">Substack</a>.
  </p>

  {issues.length === 0 ? (
    <p class="text-sm text-slate-500">No issues yet.</p>
  ) : (
    <div class="flex flex-col">
      {issues.map((issue) => (
        <a href={`/newsletter/${issue.data.slug}/`} class="group flex items-baseline justify-between gap-6 border-b border-slate-100 py-3 last:border-0" style="text-decoration:none">
          <span class="text-sm text-slate-800 transition-colors duration-150 group-hover:text-slate-500">{issue.data.title}</span>
          <time class="shrink-0 text-xs text-slate-400">{formatIssueDate(issue)}</time>
        </a>
      ))}
    </div>
  )}
</BaseLayout>

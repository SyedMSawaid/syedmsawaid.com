---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { favoriteRoute } from "@/lib/content";

const movies = (await getCollection("movies")).sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
---

<BaseLayout title="Movies">
  <h1 class="mb-8 text-2xl font-semibold tracking-tight text-slate-900">Movies</h1>
  <p class="-mt-4 mb-10 text-sm text-slate-500">Films I keep thinking about.</p>
  <div class="flex flex-col">
    {movies.map((movie) => {
      const meta = [movie.data.director, movie.data.year].filter(Boolean).join(" · ");
      return (
        <a href={favoriteRoute("movies", movie)} class="group block border-b border-slate-100 py-4 last:border-0">
          <div class="flex items-baseline justify-between gap-6">
            <span class="text-sm font-medium text-slate-900 transition-colors duration-150 group-hover:text-slate-500">{movie.data.title}</span>
            <span class="shrink-0 text-xs text-slate-400">{meta}</span>
          </div>
        </a>
      );
    })}
  </div>
</BaseLayout>

---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { favoriteRoute } from "@/lib/content";

const people = (await getCollection("people")).sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BaseLayout title="People">
  <h1 class="mb-8 text-2xl font-semibold tracking-tight text-slate-900">People</h1>
  <p class="-mt-4 mb-10 text-sm text-slate-500">People I follow and learn from.</p>
  <div class="flex flex-col">
    {people.map((person) => {
      const meta = person.data.channel ? "YouTube" : "";
      return (
        <a href={favoriteRoute("people", person)} class="group block border-b border-slate-100 py-4 last:border-0">
          <div class="flex items-baseline justify-between gap-6">
            <span class="text-sm font-medium text-slate-900 transition-colors duration-150 group-hover:text-slate-500">{person.data.name}</span>
            <span class="shrink-0 text-xs text-slate-400">{meta}</span>
          </div>
        </a>
      );
    })}
  </div>
</BaseLayout>

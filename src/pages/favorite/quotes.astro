---
import BaseLayout from "@/layouts/BaseLayout.astro";
import quotesData from "@/data/quotes.yaml";

interface Quote {
  text: string;
  author?: string;
  source?: string;
  url?: string;
}

interface QuotesFile {
  title: string;
  description?: string;
  items: Quote[];
}

const { title, description, items } = quotesData as QuotesFile;
---

<BaseLayout title={title}>
  <h1 class="mb-8 text-2xl font-semibold tracking-tight text-slate-900">{title}</h1>
  {description && <p class="-mt-4 mb-10 text-sm text-slate-500">{description}</p>}
  <div class="flex flex-col">
    {items.map((quote) => {
      const attribution = quote.author ?? quote.source;
      return (
        <div class="border-b border-slate-100 py-6 last:border-0">
          <p class="mb-3 text-base leading-relaxed text-slate-900">{quote.text}</p>
          {attribution &&
            (quote.url ? (
              <a
                href={quote.url}
                target="_blank"
                rel="noopener"
                class="text-xs tracking-widest text-slate-400 uppercase transition-colors duration-150 hover:text-slate-900"
              >
                {attribution}
              </a>
            ) : (
              <span class="text-xs tracking-widest text-slate-400 uppercase">{attribution}</span>
            ))}
        </div>
      );
    })}
  </div>
</BaseLayout>

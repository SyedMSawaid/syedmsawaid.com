---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { favoriteRoute } from "@/lib/content";

const blogs = (await getCollection("blogs")).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout title="Blogs">
  <h1 class="mb-8 text-2xl font-semibold tracking-tight text-slate-900">Blogs</h1>
  <p class="-mt-4 mb-10 text-sm text-slate-500">Sites I keep coming back to.</p>
  <div class="flex flex-col">
    {blogs.map((blog) => (
      <a href={favoriteRoute("blogs", blog)} class="group block border-b border-slate-100 py-4 last:border-0">
        <div class="flex items-baseline justify-between gap-6">
          <span class="text-sm font-medium text-slate-900 transition-colors duration-150 group-hover:text-slate-500">{blog.data.title}</span>
          {blog.data.author && <span class="shrink-0 text-xs text-slate-400">{blog.data.author}</span>}
        </div>
        {blog.data.description && <p class="mt-1 mb-0 text-sm leading-relaxed text-slate-500">{blog.data.description}</p>}
      </a>
    ))}
  </div>
</BaseLayout>

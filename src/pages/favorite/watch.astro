---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Tags from "@/components/Tags.astro";
import { favoriteRoute } from "@/lib/content";

const watched = (await getCollection("watch")).sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
---

<BaseLayout title="Watch">
  <h1 class="mb-8 text-2xl font-semibold tracking-tight text-slate-900">Watch</h1>
  <p class="-mt-4 mb-10 text-sm text-slate-500">Movies, shows, and videos worth keeping.</p>
  <div class="flex flex-col">
    {watched.map((entry) => {
      const meta = [entry.data.type, entry.data.creator, entry.data.year].filter(Boolean).join(" · ");
      return (
        <a href={favoriteRoute("watch", entry)} class="group block border-b border-slate-100 py-4 last:border-0">
          <div class="flex items-baseline justify-between gap-6">
            <span class="text-sm font-medium text-slate-900 transition-colors duration-150 group-hover:text-slate-500">{entry.data.title}</span>
            <span class="shrink-0 text-xs text-slate-400">{meta}</span>
          </div>
          <Tags tags={entry.data.tags} />
        </a>
      );
    })}
  </div>
</BaseLayout>
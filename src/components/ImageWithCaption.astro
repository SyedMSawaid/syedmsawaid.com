---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="mb-6 flex flex-col gap-2 rounded-md border border-gray-300 bg-gray-200 px-3 py-4">
  <Image {src} {alt} width={src.width} height={src.height} loading="lazy" decoding="async" class="h-auto w-full" />
  <figcaption class="text-center text-sm text-slate-600">{caption}</figcaption>
</figure>

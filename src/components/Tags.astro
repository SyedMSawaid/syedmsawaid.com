---
interface Props {
  tags?: string[];
}

const { tags = [] } = Astro.props;
---

{
  tags.length > 0 && (
    <div class="mt-2 flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs text-slate-500">{tag}</span>
      ))}
    </div>
  )
}

---
const updatedAt = new Date();
const updatedDate = updatedAt.toISOString().slice(0, 10);
const version = `v${updatedDate.replaceAll("-", ".")}`;
const updatedLabel = `Website updated on ${new Intl.DateTimeFormat("en-US", {
  dateStyle: "long",
  timeZone: "UTC",
}).format(updatedAt)}`;
---

<footer class="mt-20 flex items-center justify-between border-t border-slate-100 pt-6 text-xs text-slate-400">
  <div class="flex flex-wrap items-center gap-x-2">
    <span>&copy; {updatedAt.getUTCFullYear()} Syed Muhammad Sawaid</span>
    <time datetime={updatedDate} title={updatedLabel} aria-label={updatedLabel}>{version}</time>
  </div>
  <a href="/contact" class="transition-colors duration-150 hover:text-slate-900">Contact</a>
</footer>

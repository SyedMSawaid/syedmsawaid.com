---
import type { CollectionEntry } from "astro:content";
import { formatPostDate, postRoute, readingTime } from "../lib/content";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  post: CollectionEntry<"posts">;
  previous?: CollectionEntry<"posts">;
  next?: CollectionEntry<"posts">;
}

const { post, previous, next } = Astro.props;
---

<BaseLayout title={post.data.title}>
  <article>
    <header class="mb-10">
      <h1 class="mb-3 text-2xl leading-tight font-semibold tracking-tight text-slate-900">{post.data.title}</h1>
      <div class="flex items-center gap-2 text-xs tracking-wider text-slate-400 uppercase">
        <time datetime={post.data.date.toISOString()}>{formatPostDate(post, "long")}</time>
        <span>&middot;</span>
        <span>{readingTime(post.body ?? "")} min read</span>
      </div>
    </header>

    <div class="prose"><slot /></div>

    <nav class="mt-16 grid grid-cols-2 gap-8 border-t border-slate-100 pt-8">
      <div>
        {previous && (
          <a href={postRoute(previous).url} class="group block" style="text-decoration:none">
            <span class="text-xs font-medium tracking-widest text-slate-400 uppercase transition-colors duration-150 group-hover:text-slate-900">Previous</span>
            <p class="mt-1 mb-0 text-sm leading-snug text-slate-800 transition-colors duration-150 group-hover:text-slate-500">{previous.data.title}</p>
          </a>
        )}
      </div>
      <div class="text-right">
        {next && (
          <a href={postRoute(next).url} class="group block" style="text-decoration:none">
            <span class="text-xs font-medium tracking-widest text-slate-400 uppercase transition-colors duration-150 group-hover:text-slate-900">Next</span>
            <p class="mt-1 mb-0 text-sm leading-snug text-slate-800 transition-colors duration-150 group-hover:text-slate-500">{next.data.title}</p>
          </a>
        )}
      </div>
    </nav>
  </article>
</BaseLayout>

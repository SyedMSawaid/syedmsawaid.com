---
layout: default
---

<div class="flex flex-col items-center justify-between gap-6 mb-14 sm:flex-row">
  <div>
    <h1 class="mb-3 text-xl font-semibold tracking-tight text-slate-900">Syed Muhammad Sawaid</h1>
    <p class="m-0 text-sm leading-relaxed text-slate-500">
      Software engineer and filmmaker based in Marburg, Germany. Doing a Masters in Data Science at Philipps University Marburg. I write about software, life in Germany, and whatever catches my attention.
    </p>
  </div>
  <img src="/images/sawaid.jpg" alt="Syed Muhammad Sawaid" class="order-first object-cover w-32 h-32 rounded-xl shrink-0 sm:order-last">
</div>

<section class="mb-12">
  <h2 class="mb-5 text-xs font-medium tracking-widest uppercase text-slate-400">Writing</h2>
  <div class="flex flex-col">
    {% for post in collections.posts.resources limit:5 %}
    <a href="{{ post.relative_url }}" class="flex items-baseline justify-between gap-6 py-2.5 border-b border-slate-100 last:border-0 group">
      <span class="text-sm truncate transition-colors duration-150 text-slate-800 group-hover:text-slate-500">{{ post.title }}</span>
      <time class="text-xs text-slate-400 shrink-0">{{ post.data.date | date: '%b %Y' }}</time>
    </a>
    {% endfor %}
  </div>
  <a href="/posts" class="inline-block mt-4 text-xs transition-colors duration-150 text-slate-400 hover:text-slate-900">All writing →</a>
</section>

<section class="mb-12">
  <h2 class="mb-5 text-xs font-medium tracking-widest uppercase text-slate-400">Software</h2>
  <div class="flex flex-col">
    {% for project in collections.software.resources %}
    <a href="{{ project.relative_url }}" class="flex items-baseline justify-between gap-6 py-2.5 border-b border-slate-100 last:border-0 group">
      <span class="text-sm transition-colors duration-150 text-slate-800 group-hover:text-slate-500">{{ project.data.title }}</span>
      <span class="text-xs text-slate-400 shrink-0">{{ project.data.type }}</span>
    </a>
    {% endfor %}
  </div>
  <a href="/software" class="inline-block mt-4 text-xs transition-colors duration-150 text-slate-400 hover:text-slate-900">All projects →</a>

  <div class="pt-10">
    <div class="pb-2">
      <h2 class="text-lg font-bold">Future ventures</h2>
      <p class="text-sm">Things that I want to teach myself in 2026</p>
    </div>
    <ul class="list-disc list-inside">
      <li>Machine Leaning and Data Science</li>
      <li>Security</li>
      <li>DevOps</li>
      <li>Embedded Systems</li>
      <li>Scalable Systems</li>
      <li>Electrical Engineering</li>
    </ul>
  </div>
</section>

<section>
  <h2 class="mb-5 text-xs font-medium tracking-widest uppercase text-slate-400">Get in touch</h2>
  <div class="flex flex-col gap-1.5">
    <a href="mailto:hi@syedmsawaid.com" class="text-sm transition-colors duration-150 text-slate-700 hover:text-slate-400">hi@syedmsawaid.com</a>
    <a href="https://x.com/syedmsawaid" target="_blank" rel="noopener" class="text-sm transition-colors duration-150 text-slate-700 hover:text-slate-400">@syedmsawaid on X</a>
    <a href="https://instagram.com/syedmsawaid" target="_blank" rel="noopener" class="text-sm transition-colors duration-150 text-slate-700 hover:text-slate-400">@syedmsawaid on Instagram</a>
  </div>
</section>
